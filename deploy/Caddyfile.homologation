# Only HTTPS on localhost. Never expose the admin site to public networks.
# Serves the separate repository's dist-hml from a read-only bind mount.
# /api/v1/auth and /api/v1/admin stay protected by Spring Security and CSRF.
https://localhost {
    tls internal
    encode gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    @api path /api/* /actuator/health
    header @api Cache-Control "no-store"
    handle @api {
        reverse_proxy backend:8080
    }

    @adminPage path /admin.html /admin-experiences.html /reset-password.html /confirm-email.html
    header @adminPage Cache-Control "no-store"
    handle {
        root * /srv/site
        file_server
    }
}
