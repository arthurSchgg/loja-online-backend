# Copy to .env.staging for the ISOLATED local HTTPS staging stack.
# Do not reuse local passwords; never commit the resulting .env.staging.
DB_NAME=lojinha_staging
DB_USERNAME=lojinha_staging
DB_PASSWORD=replace-with-a-different-staging-db-password
ADMIN_USERNAME=admin-staging
ADMIN_PASSWORD=replace-with-a-different-strong-staging-password
# Test identities only. Mailpit captures outgoing messages locally; no real recipients.
ADMIN_EMAIL=admin-staging@example.invalid
MAIL_FROM=no-reply@staging.invalid

# Generate a fresh 32-byte Base64 key in your untracked .env.staging.
# An empty key keeps recovery/change-email mail disabled.
EMAIL_OUTBOX_KEY=

# Fake frontend confirmation destinations used only to inspect generated links.
# A real frontend must implement these pages before end-to-end UI homologation.
ADMIN_PASSWORD_RESET_URL=https://localhost:8443/reset-password
ADMIN_EMAIL_CHANGE_URL=https://localhost:8443/confirm-email

STAGING_HTTPS_PORT=8443
STAGING_MAILPIT_UI_PORT=8025
